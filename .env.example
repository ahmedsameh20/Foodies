# Copy to .env and fill in. NEVER commit the real .env or paste real keys into this file.

# ---- App -----------------------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Public https URL of the site. Production REQUIRES https: it is used for payment redirects, webhook URLs and Secure cookies.
APP_URL=http://localhost:3000
# Number of reverse proxies in front of the app (0 when exposed directly, 1 behind nginx/Caddy/a PaaS router)
TRUST_PROXY=0
# Tenant addressing: with TENANT_BASE_DOMAIN=yourplatform.com every approved restaurant is also served at
# https://<restaurant-slug>.yourplatform.com (needs wildcard DNS + a wildcard TLS certificate). Leave empty for path-based URLs only
# (/restaurant/<slug> and /r/<slug> always work). Restaurants can also be given a custom domain by an admin.
TENANT_BASE_DOMAIN=
# Show the original static sample site under /legacy (never served in production unless set to 1)
SERVE_LEGACY=

# ---- Database ------------------------------------------------------------------------------------------
# SQLite file (use a persistent volume in production) and the folder for uploaded images
# PRODUCTION: DATABASE_URL=postgres://user:password@host:5432/database?sslmode=verify-full  (UTF8 database; several app instances allowed; docs/DATABASE.md)
# DEVELOPMENT / single instance: leave empty to use the SQLite file below, or DATABASE_URL=sqlite:./data/app.db
DATABASE_URL=
# optional PostgreSQL schema for the app's tables (created if missing)
DATABASE_SCHEMA=
DATABASE_PATH=./data/app.db
UPLOAD_DIR=./uploads

# ---- Authentication ------------------------------------------------------------------------------------
# REQUIRED in production, min 32 random characters. Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12
# Platform admins must enrol in TOTP two-factor authentication (Admin -> Security). Defaults to ON in production, OFF in development.
REQUIRE_ADMIN_2FA=
# set to "off" only for automated tests
RATE_LIMIT=on

# ---- Marketplace money ----------------------------------------------------------------------------------
# Use SAR for a Saudi merchant. USD is only valid if the payment provider confirmed USD charging AND settlement (docs/PAYMENTS.md). Required in production.
CURRENCY=SAR
# Platform commission on the food value of each order, in basis points (1000 = 10%). Admins can change it at runtime.
PLATFORM_COMMISSION_BP=1000
# Fixed commission per order (minor units, e.g. 150 = 1.50) added to the percentage, and the minimum weekly payout. Admins can change both in Admin -> Settings.
PLATFORM_COMMISSION_FIXED_CENTS=0
MIN_PAYOUT_CENTS=0
# Optional customer-paid service fee kept by the platform: percent of food value (bp) + fixed minor units
SERVICE_FEE_BP=0
SERVICE_FEE_FIXED_CENTS=0
# Estimated provider fee, recorded for traceability (reconcile with the provider's payout report) and who bears it
PAYMENT_FEE_BP=0
PAYMENT_FEE_FIXED_CENTS=0
PAYMENT_FEE_BORNE_BY=platform
# Unpaid card orders are cancelled (after one last check with the provider) after this many minutes
UNPAID_ORDER_TTL_MINUTES=30
# provider_settled = the provider routes each restaurant's share to its connected account (Tap destinations);
# manual_transfer = the platform holds the money and pays restaurants itself (cash commission is netted off)
PAYOUT_MODE=provider_settled
WEEKLY_PAYOUT_SCHEDULER=on
# SaaS subscriptions (what restaurants pay the platform): plan code used when a restaurant does not choose one,
# and how many days a restaurant keeps access after a renewal invoice is issued and unpaid.
# Plans themselves (names, prices, limits, trials) are edited in Admin -> Plans.
DEFAULT_PLAN=free
SAAS_GRACE_DAYS=7

# ---- Payments (Tap Payments) ----------------------------------------------------------------------------
# Exact variables, from Tap's documentation (details: docs/PAYMENTS.md section 11). No real value belongs in this file.
# none = card payments off (cash on delivery only). tap = Tap Payments. In production a missing provider/merchant id reports MISCONFIGURED.
PAYMENT_PROVIDER=none
# sandbox | production. A sk_test_ key requires sandbox and a sk_live_ key requires production (startup refuses a mix).
PAYMENT_ENV=sandbox
# MERCHANT secret key (sk_test_... sandbox / sk_live_... live): charges, refunds, tokens, destination lookup, payouts list. SERVER ONLY.
# (PAYMENT_SECRET_KEY is the legacy alias; PAYMENT_* wins when both are set.)
TAP_SECRET_KEY=
# Your Tap merchant id: sent as merchant.id on charges and used to filter the payouts list. Required in production.
TAP_MERCHANT_ID=
# Only if Tap ever issues a separate webhook secret. Tap documents signing webhooks with the secret key (the default here).
TAP_WEBHOOK_SECRET=
PAYMENT_SECRET_KEY=
PAYMENT_MERCHANT_ID=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_PUBLIC_KEY=
PAYMENT_API_BASE=https://api.tap.company/v2
# Tap MARKETPLACE keys (used to onboard restaurant Businesses) are NOT read by this app: an admin uses them in Tap's dashboard/API.
# The restaurant's Tap destination id is stored in the database (Admin -> Restaurants -> Payment account), not here.
# Webhook URL to give Tap (also sent with every charge as post.url): https://YOUR-DOMAIN/webhooks/tap  (APP_URL must be https in production)
# Automatic SaaS renewal with a saved card (Tap card-on-file). Implemented from the docs but NOT verified in Tap's sandbox: leave off.
SAAS_AUTO_RENEWAL=off

# ---- Support -------------------------------------------------------------------------------------------
# WhatsApp click-to-chat number, international format, digits only (00966... or +966... are normalised)
WHATSAPP_NUMBER=00966566148975

# ---- Email (password reset, email verification) -------------------------------------------------------
# Any SMTP provider. Without it, production cannot send reset/verification mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
# alias of SMTP_PASS
SMTP_PASSWORD=
MAIL_FROM="Foodies <no-reply@example.com>"

# ---- Logging -------------------------------------------------------------------------------------------
# debug | info | warn | error | silent   (structured JSON on stdout; secrets and payment data are redacted)
LOG_LEVEL=info
